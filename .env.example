# ---------------------------------------------------------------
# Threads API  (required)
# Get these from https://developers.facebook.com/apps/
# ---------------------------------------------------------------
THREADS_ACCESS_TOKEN=your_threads_access_token_here
THREADS_USER_ID=your_threads_user_id_here

# ---------------------------------------------------------------
# AWS S3  (optional — only needed for image/video uploads)
# The IAM user needs s3:PutObject on the bucket.
# Make sure the bucket has a public read policy or use a CDN URL.
# ---------------------------------------------------------------
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name
